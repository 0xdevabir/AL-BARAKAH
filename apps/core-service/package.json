{
  "name": "@albarakah/core-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & PORT=4020 SERVICE_ROLE=api node --env-file=../../.env --watch dist/main.js",
    "start": "node dist/main.js",
    "start:worker": "SERVICE_ROLE=worker node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@albarakah/contracts": "workspace:*",
    "@albarakah/database": "workspace:*",
    "@albarakah/domain": "workspace:*",
    "@albarakah/nest-common": "workspace:*",
    "@aws-sdk/client-s3": "3.920.0",
    "@aws-sdk/s3-request-presigner": "3.920.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-fastify": "12.3.2",
    "bullmq": "5.69.2",
    "fastify": "5.12.7",
    "ioredis": "5.9.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}

