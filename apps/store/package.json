{
  "name": "@albarakah/store",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev --port 5173",
    "build": "vite build",
    "build:mobile": "BUILD_TARGET=mobile vite build",
    "apk": "cd android && ./gradlew assembleDebug",
    "start": "node build",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "budget": "node scripts/check-budget.mjs"
  },
  "dependencies": {
    "@albarakah/domain": "workspace:*",
    "@albarakah/ui": "workspace:*"
  },
  "devDependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.3",
    "@capacitor/cli": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource/noto-sans-bengali": "5.3.0",
    "@inlang/paraglide-js": "2.29.3",
    "@sveltejs/adapter-node": "6.0.1",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "22.19.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}

