{
  "name": "@albarakah/auth-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & AUTH_PORT=4010 PORT=4010 node --env-file=../../.env --watch dist/main.js",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@albarakah/contracts": "workspace:*",
    "@albarakah/database": "workspace:*",
    "@albarakah/nest-common": "workspace:*",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-fastify": "12.3.2",
    "bullmq": "5.69.2",
    "fastify": "5.12.7",
    "ioredis": "5.9.3",
    "nodemailer": "^10.3.1",
    "otplib": "12.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7",
    "@fastify/cookie": "11.1.5"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/nodemailer": "^8.0.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
