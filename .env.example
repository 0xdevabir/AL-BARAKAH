# Copy to .env. Everything is validated at boot (apps/api/src/config/env.ts).
# These values are for local development. docs/runbook.md lists what production changes.
NODE_ENV=development
# api | worker | all
SERVICE_ROLE=all
PORT=4000
POSTGRES_PASSWORD=change-me-local
DATABASE_URL=postgresql://albarakah:change-me-local@localhost:55432/albarakah
REDIS_URL=redis://localhost:56379
S3_ENDPOINT=localhost
S3_PORT=59000
S3_USE_SSL=false
S3_ACCESS_KEY=albarakah
S3_SECRET_KEY=change-me-minio
S3_BUCKET=albarakah-private
JWT_SECRET=replace-with-at-least-32-random-characters-a
OTP_PEPPER=replace-with-at-least-32-random-characters-b
TOTP_ENCRYPTION_KEY=replace-with-at-least-32-random-characters-c
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,capacitor://localhost,https://localhost
PUBLIC_API_BASE=http://localhost:4000
STORE_URL=http://localhost:5173
# console (prints codes to the log, dev only) | bulksmsbd (bulksmsbd.net)
SMS_PROVIDER=console
# Both required for bulksmsbd. The sender ID must be approved on your account.
SMS_API_KEY=
SMS_SENDER_ID=
# fake (dev only) | sandbox | live
BKASH_MODE=fake
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
# One-tap demo sign-in buttons for testing. The API refuses to start with this on in production.
DEMO_LOGIN=true
# Requests per address per minute. Many mobile users can share one carrier address.
RATE_LIMIT_PER_MINUTE=1200

# Production only (infra/compose.app.yml).
# STORE_DOMAIN=albarakah.example
# STAFF_DOMAIN=staff.albarakah.example
# FILES_DOMAIN=files.albarakah.example
# S3_PUBLIC_URL=https://files.albarakah.example
# FIRST_ADMIN_PHONE=+8801XXXXXXXXX
