# Copy to .env. Everything is validated at boot (apps/core-service/src/config/env.ts).
# These values are for local development. docs/runbook.md lists what production changes.
NODE_ENV=development
# api | worker | all
SERVICE_ROLE=all
PORT=4000
POSTGRES_PASSWORD=change-me-local
DATABASE_URL=postgresql://albarakah:change-me-local@localhost:55432/albarakah
REDIS_URL=redis://localhost:56379
S3_ENDPOINT=localhost
S3_PORT=59000
S3_USE_SSL=false
S3_ACCESS_KEY=albarakah
S3_SECRET_KEY=change-me-minio
S3_BUCKET=albarakah-private
# Cloudflare R2 (or any hosted S3). S3_URL replaces S3_ENDPOINT/S3_PORT/S3_USE_SSL above,
# and the compose file's built-in storage settings. Leave S3_PUBLIC_URL unset with R2.
# S3_URL=https://<account id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY=<R2 API token Access Key ID>
# S3_SECRET_KEY=<R2 API token Secret Access Key>
# S3_BUCKET=albarakah-private
# Public bucket for product photos uploaded from the staff app (optional, set both or neither).
# S3_IMAGES_BUCKET=albarakah-images
# S3_IMAGES_PUBLIC_URL=https://images.barakabari.com
JWT_SECRET=replace-with-at-least-32-random-characters-a
OTP_PEPPER=replace-with-at-least-32-random-characters-b
TOTP_ENCRYPTION_KEY=replace-with-at-least-32-random-characters-c
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:5174,capacitor://localhost,https://localhost
PUBLIC_API_BASE=http://localhost:4000
STORE_URL=http://localhost:5173
# console (prints codes to the log, dev only) | bulksmsbd (bulksmsbd.net)
SMS_PROVIDER=console

# Email login codes. console logs the code; smtp sends through your mail server.
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# Both required for bulksmsbd. The sender ID must be approved on your account.
SMS_API_KEY=
SMS_SENDER_ID=
# fake (dev only) | sandbox | live
BKASH_MODE=fake
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
# One-tap demo sign-in buttons for testing. The API refuses to start with this on in production.
DEMO_LOGIN=true
# Requests per address per minute. Many mobile users can share one carrier address.
RATE_LIMIT_PER_MINUTE=1200

# Production only (infra/compose.app.yml).
# STORE_DOMAIN=barakabari.com
# STAFF_DOMAIN=staff.barakabari.com
# FILES_DOMAIN=files.barakabari.com
# S3_PUBLIC_URL=https://files.barakabari.com
# FIRST_ADMIN_PHONE=+8801XXXXXXXXX
