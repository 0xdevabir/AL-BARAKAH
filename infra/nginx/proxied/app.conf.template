# Behind a host nginx (or other proxy) that terminates TLS and owns ports 80/443.
# Publish this container on loopback only (EDGE_HTTP_PORT=127.0.0.1:8080), since it trusts the
# proxy's X-Forwarded-For and X-Forwarded-Proto.

# The visitor's address, as the host proxy saw it. The shared config then overwrites X-Forwarded-For with it.
set_real_ip_from 127.0.0.1;
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

map $http_x_forwarded_proto $fwd_proto {
  default $http_x_forwarded_proto;
  "" $scheme;
}

map $http_origin $files_cors_origin {
  default "";
  "https://${STORE_DOMAIN}" $http_origin;
  "https://${STAFF_DOMAIN}" $http_origin;
  "capacitor://localhost" $http_origin;
  "https://localhost" $http_origin;
}
include /etc/nginx/shared/upstreams.conf;

server {
  listen 80 default_server;
  server_name ${STORE_DOMAIN};
  include /etc/nginx/shared/store-site.conf;
}
server {
  listen 80;
  server_name ${STAFF_DOMAIN};
  include /etc/nginx/shared/staff-site.conf;
}
server {
  listen 80;
  server_name ${FILES_DOMAIN};
  include /etc/nginx/shared/files-site.conf;
}
