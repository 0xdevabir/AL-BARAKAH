{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/admin",
      "regex": "^/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin(?:/)?$"
    },
    {
      "page": "/admin/consultations",
      "regex": "^/admin/consultations(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/consultations(?:/)?$"
    },
    {
      "page": "/admin/medicines",
      "regex": "^/admin/medicines(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/medicines(?:/)?$"
    },
    {
      "page": "/admin/people",
      "regex": "^/admin/people(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/people(?:/)?$"
    },
    {
      "page": "/admin/settings",
      "regex": "^/admin/settings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/settings(?:/)?$"
    },
    {
      "page": "/delivery",
      "regex": "^/delivery(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/delivery(?:/)?$"
    },
    {
      "page": "/delivery/earnings",
      "regex": "^/delivery/earnings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/delivery/earnings(?:/)?$"
    },
    {
      "page": "/doctor",
      "regex": "^/doctor(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/doctor(?:/)?$"
    },
    {
      "page": "/doctor/availability",
      "regex": "^/doctor/availability(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/doctor/availability(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}